# =========================================================
# APPLICATION CONFIGURATION
# =========================================================
APP_ENV=development
LOG_LEVEL=INFO

# =========================================================
# DATABASE
# =========================================================
DATABASE_URL=sqlite:///./storage/app.db

# =========================================================
# STORAGE & PATHS
# =========================================================
STORAGE_DIR=./storage/projects
FFMPEG_PATH=
FFPROBE_PATH=
VSF_PATH=
VSF_THREADS=0
VSF_USE_CUDA=false
VSF_USE_SCAN_PROXY=true
VSF_PROXY_WIDTH=960

# =========================================================
# NETWORK & DOWNLOAD LIMITS
# =========================================================
REQUEST_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_SIZE_BYTES=8589934592 # 8 GiB
MAX_VIDEO_DURATION_SECONDS=10800   # 3 hours
MAX_DOWNLOAD_ATTEMPTS=30
MAX_RETRIES=3
BACKOFF_FACTOR=1.5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# Bilibili Quality & Auth
BILIBILI_PREFERRED_QUALITY=80      # 16=360P, 32=480P, 64=720P, 80=1080P, 116=1080P60
BILIBILI_COOKIE=
DOUYIN_COOKIE_FILE=
DOUYIN_BROWSER_PROFILE=
BILIBILI_SESSDATA=

# =========================================================
# AUDIO & SPEECH-TO-TEXT (STT)
# =========================================================
AUDIO_SAMPLE_RATE=16000
WHISPER_MODEL_SIZE=auto          # auto | tiny | base | small | medium | large-v3 | large-v3-turbo
WHISPER_DEVICE=auto              # auto | cuda | cpu
WHISPER_COMPUTE_TYPE=auto        # auto | int8 | int8_float16 | float16 | float32
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=true
WHISPER_VAD_THRESHOLD=0.35
WHISPER_VAD_MIN_SILENCE_MS=500
WHISPER_VAD_SPEECH_PAD_MS=400
STT_AUDIO_FILTER=highpass=f=180,lowpass=f=3400,afftdn=nf=-25
FFMPEG_TIMEOUT_SECONDS=1800

# =========================================================
# AI & TRANSLATION
# =========================================================
AI_PROVIDER=gemini            # gemini | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Gemini (lấy khoá tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3-flash-preview
TARGET_LANGUAGE=vi
TRANSLATION_MODEL=gemini-3.5-flash-lite
TRANSLATION_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite
TRANSLATION_REPAIR_MODEL=gemini-3.8-flash
TRANSLATION_BATCH_SIZE=100
TRANSLATION_BATCH_MAX_CHARS=18000
TRANSLATION_AUTO_GLOSSARY=true
TRANSLATION_GLOSSARY_MIN_CUES=100
TRANSLATION_KEY_RPM=12
TRANSLATION_MAX_WORKERS=5
# Optional local HY-MT runtime (explicit provider; never a silent fallback)
LOCAL_TRANSLATION_URL=
LOCAL_TRANSLATION_API_KEY_FILE=config/local_translation.key
TRANSLATION_MAX_TOKENS=16000
AI_CONCURRENCY=3

# =========================================================
# TEXT-TO-SPEECH (TTS) & DUBBING
# =========================================================
TTS_PROVIDER=edge             # edge | gemini
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+12%
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FALLBACK_MODELS=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
TTS_SAMPLE_RATE=24000
TTS_TRIM_SILENCE=true
TTS_TRIM_KEEP_MS=60
TTS_SILENCE_FLOOR=300
TTS_CONCURRENCY=4
# CPU threads inside one local VieNeu model; benchmark before changing.
VIENEU_CPU_THREADS=2
TTS_NETWORK_CONCURRENCY=8
TTS_REQUEST_TIMEOUT_SECONDS=30
TTS_TOTAL_DEADLINE_SECONDS=120
TTS_MAX_RETRIES=5
TTS_REQUEST_DELAY=1.0
EMOTION_DUBBING=true
EMOTION_BATCH_SIZE=40
SPEECH_WORDS_PER_SECOND=4.2
ORIGINAL_AUDIO_VOLUME=0.15
VOICEOVER_VOLUME=1.7

# =========================================================
# SUBTITLES & VIDEO ENCODING
# =========================================================
SUBTITLE_MODE=burn            # off | soft | burn
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=20
SUBTITLE_COLOR=&H00FFFFFF
SUBTITLE_OUTLINE=2.5
SUBTITLE_BOLD=true
SUBTITLE_MARGIN_V=28
SUBTITLE_BURN_CRF=18
SUBTITLE_BURN_PRESET=faster
VIDEO_ENCODER=auto            # auto | nvenc | cpu

# Clean Overlays (watermark & hardsub)
CLEAN_OVERLAYS=true
CLEAN_SAMPLE_FRAMES=24
CLEAN_MIN_CONFIDENCE=0.6
CLEAN_WATERMARK_MAX_AREA=0.06
CLEAN_SUBTITLE_BAND_MAX_H=0.14
CLEAN_SUBTITLE_BOTTOM_PAD_PX=8

# =========================================================
# SCENE DETECTION & OCR
# =========================================================
SCENE_THRESHOLD=0.35
MIN_SCENE_DURATION=1.0
MAX_SCENES=200
KEYFRAME_WIDTH=640
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
TESSERACT_PATH=
TESSDATA_PREFIX=

# =========================================================
# SECURITY
# =========================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false
MAX_UPLOAD_SIZE_BYTES=524288000
MAX_DOWNLOAD_REDIRECTS=5
ENFORCE_DOWNLOAD_HOST_ALLOWLIST=true
LOCAL_FILE_ALLOWED_DIRS=

# Optional single-host server mode. Prefer start_small_server.bat for LAN.
SERVER_MODE=false
# Fixed HTTPS URL of a configured reverse proxy/tunnel; blank means LAN only.
SERVER_PUBLIC_URL=
SERVER_SESSION_HOURS=8
SERVER_COOKIE_SECURE=false
SERVER_LEASE_SECONDS=60
# Verified backup when idle; 0 disables automatic backup. Existing backups are not auto-deleted.
SERVER_AUTO_BACKUP_HOURS=24
# Optional versioned replica directory. A same-disk replica NEVER allows deleting originals.
SERVER_BACKUP_DIRECTORY=
SERVER_BACKUP_ROOT=
SERVER_BACKUP_ALLOW_SAME_DISK=false

# Resumable upload settings (bytes); existing MAX_UPLOAD_SIZE_BYTES still applies.
UPLOAD_CHUNK_SIZE_BYTES=8388608
UPLOAD_SESSION_HOURS=48
MAX_ACTIVE_UPLOADS_PER_USER=3
MIN_FREE_DISK_START_BYTES=1073741824
MIN_FREE_DISK_RUNTIME_BYTES=268435456
MAX_SOURCE_VIDEO_DURATION_SECONDS=43200
# 0 keeps source-resolution unrestricted; measure before setting a cap.
MAX_SOURCE_RESOLUTION_HEIGHT=0
MEDIA_SAMPLE_TIMEOUT_SECONDS=30
# JSON list; only list exact trusted proxy IPs, never wildcard.
TRUSTED_PROXY_IPS=[]
